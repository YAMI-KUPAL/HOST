# Copy these into your hosting platform's environment variables.
# Only vars the code actually reads are listed here.

# Required — without a fixed secret, every redeploy/restart invalidates all
# logged-in sessions. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-this-to-a-random-64-char-hex-string

# Required for persistent storage — point to a mounted volume or writeable directory.
# Render: /data, Railway: /data, fly.io: /data, local: ./data
DATA_DIR=/data

# Optional — lock Socket.IO CORS to your real domain.
# Comma-separate multiple. Leave unset ("*") until you know the domain.
CORS_ORIGINS=*
